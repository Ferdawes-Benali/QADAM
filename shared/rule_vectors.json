{
  "_doc": "Shared test vectors for the Qadam foot-temperature rule. Used by hub/tests (Python) and app/test (Dart) so both implementations stay identical. history[].days_ago is relative to the scan being evaluated.",
  "threshold_c": 2.2,
  "cases": [
    {"name": "normal scan", "demo": false,
     "left": {"mth1": 30.8}, "right": {"mth1": 31.0}, "history": [],
     "expect": {"level": "green", "max_dt": 0.2, "site": "mth1", "confidence": 100, "confidence_label": "high", "warmer_side": "right"}},
    {"name": "single hot scan is amber", "demo": false,
     "left": {"mth1": 30.8}, "right": {"mth1": 33.6}, "history": [],
     "expect": {"level": "amber", "max_dt": 2.8, "site": "mth1", "confidence": 100, "confidence_label": "high", "warmer_side": "right"}},
    {"name": "same site hot yesterday is red", "demo": false,
     "left": {"mth1": 30.8}, "right": {"mth1": 33.6}, "history": [{"days_ago": 1, "dt": {"mth1": 2.5}}],
     "expect": {"level": "red", "max_dt": 2.8, "site": "mth1", "consecutive_days": 2}},
    {"name": "hot yesterday at another site stays amber", "demo": false,
     "left": {"mth1": 30.8, "heel": 29.0}, "right": {"mth1": 33.6, "heel": 29.1}, "history": [{"days_ago": 1, "dt": {"mth1": 0.3, "heel": 2.6}}],
     "expect": {"level": "amber", "site": "mth1", "consecutive_days": 1}},
    {"name": "normal yesterday stays amber", "demo": false,
     "left": {"mth1": 33.6}, "right": {"mth1": 30.8}, "history": [{"days_ago": 1, "dt": {"mth1": 0.4}}],
     "expect": {"level": "amber", "warmer_side": "left"}},
    {"name": "demo mode: previous scan counts as yesterday", "demo": true,
     "left": {"mth1": 30.8}, "right": {"mth1": 33.6}, "history": [{"days_ago": 0, "dt": {"mth1": 2.6}}],
     "expect": {"level": "red", "consecutive_days": 2}},
    {"name": "production mode: earlier scan today does not count", "demo": false,
     "left": {"mth1": 30.8}, "right": {"mth1": 33.6}, "history": [{"days_ago": 0, "dt": {"mth1": 2.6}}],
     "expect": {"level": "amber", "consecutive_days": 1}},
    {"name": "noisy reading near threshold has low confidence", "demo": false,
     "left": {"mth1": 30.0}, "right": {"mth1": 32.25}, "history": [], "samples": 3, "spread_left": 0.6, "spread_right": 0.2,
     "expect": {"level": "amber", "max_dt": 2.25, "confidence": 24, "confidence_label": "low"}},
    {"name": "exactly at threshold is amber", "demo": false,
     "left": {"mth1": 30.0}, "right": {"mth1": 32.2}, "history": [],
     "expect": {"level": "amber", "max_dt": 2.2, "confidence": 50, "confidence_label": "medium"}},
    {"name": "implausible temperature is rejected", "demo": false,
     "left": {"mth1": 60.0}, "right": {"mth1": 31.0}, "history": [],
     "expect": {"invalid": true}},
    {"name": "missing side is rejected", "demo": false,
     "left": {}, "right": {"mth1": 31.0}, "history": [],
     "expect": {"invalid": true}},
    {"name": "four-site mat, hot heel", "demo": false,
     "left": {"hallux": 30.5, "mth1": 30.8, "mth5": 30.2, "heel": 29.6},
     "right": {"hallux": 30.7, "mth1": 31.0, "mth5": 30.1, "heel": 32.3}, "history": [],
     "expect": {"level": "amber", "max_dt": 2.7, "site": "heel", "warmer_side": "right"}}
  ]
}
