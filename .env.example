# Copy to .env (never commit .env). All values are optional for the demo.
# --- AI assistant (server-side only; the mobile app never holds the key)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash   # check ai.google.dev/gemini-api/docs/models for the current Flash ID
# --- demo behaviour
QADAM_DEMO_MODE=1              # 1 = each scan counts as one day (shows amber -> red live)
QADAM_DEMO_DEVICE=bench-01
QADAM_DEMO_PATIENT=QDM-2048
QADAM_DEMO_PAIRING_CODE=246810
QADAM_SEED=1                   # load the synthetic dataset on first start
# --- clinician demo account (change it!)
QADAM_CLINICIAN_USER=dr.demo
QADAM_CLINICIAN_PASSWORD=qadam-demo-2026
# --- broker
QADAM_MQTT_HOST=127.0.0.1
QADAM_MQTT_PORT=1883
QADAM_EMBEDDED_BROKER=0        # 1 = start a built-in Python broker (no Mosquitto needed)
# --- data protection: base64 of 32 random bytes (AES-256). Leave empty to auto-generate hub/data/.data_key
QADAM_DATA_KEY=
