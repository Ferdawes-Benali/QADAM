  {"id": "qfn", "type": "function", "z": "qflow", "name": "Regle 2.2 C", "func": "const d = msg.payload;\nconst dt = Math.abs(d.left - d.right);\nlet n = context.get('n') || 0;\nn = dt >= 2.2 ? n + 1 : 0;\ncontext.set('n', n);\nlet statut = 'NORMAL - pas d\\'asymetrie';\nif (dt >= 2.2) statut = 'A SURVEILLER - difference ' + dt.toFixed(1) + ' C';\nif (n >= 5) statut = 'ALERTE - inflammation probable, appeler le patient';\nreturn [\n  {payload: d.left, topic: 'Gauche'},\n  {payload: d.right, topic: 'Droit'},\n  {payload: Number(dt.toFixed(2)), topic: 'Difference G/D'},\n  {payload: statut}\n];", "outputs": 4, "noerr": 0, "initialize": "", "finalize": "", "libs": [], "x": 380, "y": 160, "wires": [["qg1"], ["qg2"], ["qchart"], ["qtext"]]},
  {"id": "qg1", "type": "ui_gauge", "z": "qflow", "name": "", "group": "qgroup", "order": 1, "width": "4", "height": "4", "gtype": "gage", "title": "Pied gauche", "label": "C", "format": "{{value | number:1}}", "min": "20", "max": "40", "colors": ["#2e86de", "#27ae60", "#e67e22"], "seg1": "28", "seg2": "35", "x": 620, "y": 80, "wires": []},
  {"id": "qg2", "type": "ui_gauge", "z": "qflow", "name": "", "group": "qgroup", "order": 2, "width": "4", "height": "4", "gtype": "gage", "title": "Pied droit", "label": "C", "format": "{{value | number:1}}", "min": "20", "max": "40", "colors": ["#2e86de", "#27ae60", "#e67e22"], "seg1": "28", "seg2": "35", "x": 620, "y": 130, "wires": []},
  {"id": "qchart", "type": "ui_chart", "z": "qflow", "name": "", "group": "qgroup", "order": 3, "width": "12", "height": "5", "label": "Difference gauche/droite (C) - seuil 2.2", "chartType": "line", "legend": "false", "xformat": "HH:mm:ss", "interpolate": "linear", "nodata": "En attente du tapis...", "dot": false, "ymin": "0", "ymax": "8", "removeOlder": "5", "removeOlderPoints": "", "removeOlderUnit": "60", "cutout": 0, "useOneColor": false, "useUTC": false, "colors": ["#c0392b", "#aec7e8", "#ff7f0e", "#2ca02c", "#98df8a", "#d62728", "#ff9896", "#9467bd", "#c5b0d5"], "outputs": 1, "useDifferentColor": false, "x": 640, "y": 180, "wires": [[]]},
